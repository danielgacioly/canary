# Canary settings. Copy to .env or export them; every one is optional and the defaults are for local development only.
# Never commit real values. Change every PIN and secret before anything but a demo.

# SQLite file, created on start.
CANARY_DB=backend/canary.db

# demo: the demo mission loads on first start and demo-only routes exist. flight: nothing is loaded, the delay runs in
# real time, and CANARY_TOKEN_SECRET and CANARY_CONTROL_BOOTSTRAP_PIN are required (the server will not start without them).
CANARY_MODE=demo
# Medical console and Canary Control sign in with accounts: the crew medical officer uses their crew PIN, and flight
# surgeons and Mission Control accounts come from the package's ground.csv (or the registration form), each with its own PIN.
# First-access PIN of Canary Control (exactly 4 digits), accepted only while no Mission Control account exists.
CANARY_CONTROL_BOOTSTRAP_PIN=4242
# Fallback PIN per crew id ("id:pin,..."), used only for an id that has no stored PIN. Registered PINs are stored hashed.
CANARY_CREW_PINS=h:1001,k:1002,a:1003,t:1004
# Signs session tokens. Empty or unset: random on every start (sessions end when the server restarts).
CANARY_TOKEN_SECRET=
# Session lifetime in seconds.
CANARY_TOKEN_TTL=3600

# Secret a sensor, wearable or lab sends in the X-Canary-Key header of POST /api/observations. Empty: ingest is off.
CANARY_INGEST_KEY=
# Bundled mission package (a folder under data/missions) loaded on the first start and by Reset demo.
# Leave it empty (CANARY_MISSION_PACKAGE=) for an empty start with no crew, readings or scenes.
CANARY_MISSION_PACKAGE=odyssey1-mars
# Where bundled packages are looked up by name.
CANARY_MISSIONS_DIR=data/missions

# 1: a background thread notices a new mission day and runs what a day triggers. 0: off.
CANARY_DAY_SYNC=1
# How often that thread looks, in seconds.
CANARY_DAY_SYNC_SECONDS=600
# 1: compute everyone's health once at start-up so the first click is quick. 0: skip.
CANARY_WARM=1

# Communication delay runs this many times faster than real time in the demo.
CANARY_DELAY_SPEEDUP=20
# Minutes before an unacknowledged critical alert goes up one step (commander, then flight surgeon); sped up like the delay.
# CANARY_ESCALATE_MINUTES=10
# 1: also ask NASA DONKI for solar particle events of the last 30 days (only while the clock follows the real date).
CANARY_LIVE_SPACE_WEATHER=0
# Key for api.nasa.gov. DEMO_KEY works with low rate limits.
NASA_API_KEY=DEMO_KEY

# AI assistant. auto: one key selects that provider; both keys prefer Gemini; no key uses offline rules.
# Also: gemini | anthropic | none | local (not implemented). Keep unused keys empty; never commit real keys.
CANARY_LLM_PROVIDER=auto
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Provider-specific models allow switching by API key alone.
CANARY_GEMINI_MODEL=gemini-3.1-flash-lite
CANARY_ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional global override, used only when CANARY_LLM_PROVIDER names a provider explicitly; ignored with auto.
CANARY_LLM_MODEL=
CANARY_LLM_EFFORT=low
# One deadline per question, in seconds; past it the answer falls back to grounded rules.
CANARY_LLM_TIMEOUT_S=150
CANARY_LLM_MAX_STEPS=3
CANARY_LLM_MAX_TOOL_CALLS=6
# Knowledge retrieval: local embeddings or none (BM25 only).
CANARY_EMBEDDER=local
# Optional paid-eval price overrides, USD per million tokens (set both for another model).
# CANARY_EVAL_PRICE_IN=0.75
# CANARY_EVAL_PRICE_OUT=3.75

# Folder with the built web app, served by the API (make serve).
CANARY_FRONTEND_DIST=frontend/dist
# Other web origins allowed to call the API (comma-separated). make dev and make serve need nothing more.
CANARY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rounds of the PIN hash. Leave the default: a stored hash does not record the count, so changing it locks every stored PIN out.
# Only the test suite lowers it.
CANARY_PBKDF2_ITERATIONS=100000
