# Copy to .env in the repository root and fill in the API key you want to use.
# The backend loads the repository-root .env automatically. From the repository root:
#   make dev
# Variables already exported in the process take precedence over .env.
# Restart the backend after changing environment variables.

# AI provider: auto | gemini | anthropic | none | local (not implemented).
# auto: one key selects that provider; both keys prefer Gemini; no keys uses local rules.
# Keep unused keys empty. Never put real keys in this example or commit .env.
CANARY_LLM_PROVIDER=auto
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Provider-specific models allow switching by API key alone.
# Flash-Lite completed the live tool-calling smoke test; Flash 3.8 returned overload errors.
CANARY_GEMINI_MODEL=gemini-3.1-flash-lite
CANARY_ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional global override, used only when CANARY_LLM_PROVIDER is set explicitly (gemini or anthropic).
# With auto it is ignored and each provider uses its own model above. Leave empty for key-only switching.
CANARY_LLM_MODEL=
CANARY_LLM_EFFORT=low
# Seconds before the answer falls back to grounded rules (application default 15).
# Raise it locally for slow networks or slow models.
CANARY_LLM_TIMEOUT_S=15
CANARY_LLM_MAX_STEPS=3
CANARY_LLM_MAX_TOOL_CALLS=6

# Knowledge retrieval: local embeddings or none (BM25 only).
CANARY_EMBEDDER=local
# Optional absolute paths; leave commented to use application defaults.
# CANARY_DB=/absolute/path/to/canary/backend/canary.db
# CANARY_KB=/absolute/path/to/canary/backend/kb.db
# CANARY_FRONTEND_DIST=/absolute/path/to/canary/frontend/dist
# FASTEMBED_CACHE_PATH=/absolute/path/to/canary/backend/.cache/fastembed

# Public demo PINs. Use different values outside the demo (exactly four digits).
CANARY_MEDICAL_PIN=1961
CANARY_CREW_PINS=h:1001,k:1002,a:1003,t:1004
CANARY_TOKEN_TTL=3600
# Optional persistent signing secret. Set a random value to preserve sessions across restarts.
# Leave commented for a randomly generated secret at each backend start; do not set an empty value.
# CANARY_TOKEN_SECRET=replace-with-a-long-random-secret

# Demo communication delay and NASA space weather.
CANARY_DELAY_SPEEDUP=20
CANARY_LIVE_SPACE_WEATHER=0
NASA_API_KEY=DEMO_KEY

# Optional paid-eval price overrides, in USD per million tokens.
# Leave commented to use provider-specific estimates; set both for another model.
# CANARY_EVAL_PRICE_IN=0.75
# CANARY_EVAL_PRICE_OUT=3.75
